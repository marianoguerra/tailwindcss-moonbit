# What `moon package` leaves out of the published mooncake. This file replaces
# the deprecated `exclude` option in moon.mod, and because .moonignore overrides
# .gitignore in the same directory, it must repeat the build-artifact patterns
# too — .gitignore is no longer consulted here.

# Build artifacts and fetched dependencies.
target/
_build/
.mooncakes/
node_modules/
.playwright-mcp/

# Built MoonBit->JS module, copied next to the wrapper for local use / npm
# publish. Regenerated by `just build-npm`, so never ship a stale copy.
ffi/js/ffi.js

# Symlink to README.mbt.md that moon recreates on every build/test. Anchored:
# unanchored, this pattern also swallows every nested README.
/README.md

# Development-only trees: the differential/upstream harnesses, the showcase
# site, the benchmark suite, and the npm scripts that drive them. None of it is
# needed by a consumer of the library.
tools/
examples/
benchmarks/
web/
package.json
moon.work
